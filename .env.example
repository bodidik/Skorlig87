# SkorLig API — ortam değişkenleri örneği
# Kopyala:  cp .env.example .env   (.env repoya GİRMEZ)
#
# Yalnızca "ZORUNLU" bölümü gerçekten gereklidir; gerisi varsayılanlarla çalışır.
# Her bayrağın varsayılanı yorumda belirtilmiştir.

# ───────────────────────── ZORUNLU (production) ─────────────────────────

# MongoDB. server.cjs ve migration script'i lib/mongo.cjs üzerinden bunu okur.
# ⚠️ Ad MONGODB_URI'dır. Eski MONGO_URI yalnızca geriye uyumluluk için kabul edilir.
MONGODB_URI=mongodb+srv://kullanici:parola@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=skorlig

# Yönetim uçları (scraper-health, scraper-probe, alerts, settle2, bots-generate).
# Fail-closed: TANIMSIZSA yönetim uçları 503 ile tamamen kapanır.
SKORLIG_ADMIN_TOKEN=uzun-rastgele-bir-deger

# CORS izin listesi (virgülle ayrık, tam origin). Boş bırakılırsa production'da
# hiçbir tarayıcı origin'i kabul edilmez (mobil uygulama origin göndermez, etkilenmez).
SKORLIG_CORS_ORIGINS=https://skorlig.com,https://www.skorlig.com

# Firebase Admin (kimlik doğrulama). Biri yeterli.
FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ───────────────────────── ÖNERİLEN ─────────────────────────

# Redis — hız sınırı sayacı. TANIMSIZSA belleğe düşer: tek instance'ta doğru
# çalışır, ÇOK INSTANCE'ta limit instance başına uygulanır (yani N katına çıkar).
# Redis erişilemezse istek engellenmez (fail-open).
REDIS_URL=

# Tahmin verisi MongoDB'ye taşındıktan sonra dosya aynasını kapat.
# ⚠️ 0 yapmadan ÖNCE: node scripts/verify-migration.cjs  →  "GO" demeli.
#    0 yapıldığı anda preds.json artık YAZILMAZ; migration eksikse veri kaybı olur.
# Varsayılan: 1 (ayna açık)
SKORLIG_PREDS_FILE_MIRROR=1

# Cüzdan/kullanıcı dosya aynası (lc-wallet.json + users.json).
# Ödül dağıtımı bu iki dosyayı KOŞULSUZ baştan yazıyordu; kullanıcı sayısıyla
# doğrusal büyür ve JSON.parse/stringify SENKRON olduğu için olay döngüsünü
# bloklar (100k kullanıcıda settle 2238ms -> ayna kapalı 267ms, 8.4x).
# Mongo yazımları `$inc` ile dosyadan bağımsızdır; ayna kapalıyken ödüller
# eksiksiz Mongo'ya işlenir.
# ⚠️ MONGODB_URI YOKSA bu bayrak YOK SAYILIR (dosya tek kaynaktır, veri kaybı olmaz).
# Varsayılan: 1
SKORLIG_WALLET_FILE_MIRROR=1

# Maç sonucu snapshot dosya aynası (match-results.json).
# Her kayıt maçın TÜM sıralamasını gömer (ölçüldü: 15 kayıt / 5.3 MB) ve dosya
# her settle'da baştan yazılırdı — maliyet GEÇMİŞTEKİ MAÇ SAYISIYLA büyür,
# yani sistem yaşlandıkça her settle yavaşlar.
# ⚠️ Kırpmak çözüm DEĞİL: `awardedAt` aynı zamanda çift-ödül mührüdür ve
#    livescore-sync "hangi maçlar sonuçlandı"yı buradan okur. Eski kayıtları
#    atmak o maçların yeniden sonuçlanıp ödüllerin İKİNCİ kez dağıtılmasına
#    yol açar. Çözüm indeksli depo (Mongo `match_results` koleksiyonu).
# ⚠️ MONGODB_URI YOKSA bu bayrak YOK SAYILIR.
# Varsayılan: 1
SKORLIG_MATCHRESULTS_FILE_MIRROR=1

# ───────────────────────── VERİ KAYNAKLARI ─────────────────────────

# football-data.org — fikstür senkronu (yoksa fixture-sync başlamaz)
FDO_KEY=

# API-Football — şu an hesap askıda, şelaleden çıkarılmış durumda
AF_KEY=

# Yerel Chrome yolu (yalnızca Windows geliştirme; production @sparticuz/chromium kullanır)
# LOCAL_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# ───────────────────────── ARKA PLAN SERVİSLERİ (0 = kapat) ─────────────────────────

# SKORLIG_LIVESCORE=1        # canlı skor scraper'ı (2dk)
# SKORLIG_SYNC=1             # livescore → uygulama senkronu (30sn)
# SKORLIG_FIXTURE_SYNC=1     # fikstür senkronu (FDO 6sa + Maçkolik 3dk)
# SKORLIG_AF_SYNC=1          # API-Football senkronu
# SKORLIG_PUSH_SCHED=1       # push zamanlayıcı (5dk)
# SKORLIG_BOT_FILL=1         # bot doluluk (10dk)
# SKORLIG_SCRAPER_HEALTH=1   # scraper sağlık izleme (10dk)

# ───────────────────────── AYARLAR (varsayılanlar) ─────────────────────────

# Hız sınırı
# SKORLIG_RATE_LIMIT=1           # 0 = tamamen kapat
# SKORLIG_RATE_DEFAULT_MAX=120   # kural eşleşmeyen rotalar, dakikada
# SKORLIG_RATE_IP_MAX=600        # IP tavanı, dakikada

# Bot doluluk
# SKORLIG_BOT_TARGET=40          # maç başına hedef tahminci (bot + gerçek)
# SKORLIG_BOT_FILL_WINDOW_H=24   # kickoff'a bu kadar kalan maçlar doldurulur
# SKORLIG_BOT_FILL_MAX=25        # tur başına en fazla maç

# Scraper sağlık
# SKORLIG_SCRAPER_STALE_MIN=20   # cache bu kadar bayatsa warn
# SKORLIG_SCRAPER_CRIT_MIN=60    # bu kadar bayatsa critical
# SKORLIG_SCRAPER_MIN_SOURCES=2  # bunun altında çalışan kaynak varsa warn
# SKORLIG_PROBE_TTL_H=24         # kaynak yoklaması bu sıklıkta yenilenir

# Yönetim alarmları
# SKORLIG_ALERT_MAX=500          # saklanan en fazla alarm
# SKORLIG_ALERT_TTL_DAYS=14
# SKORLIG_ALERT_DEDUPE_MIN=30    # aynı alarm bu süre içinde tekrar yazılmaz

# Kapanış
# SKORLIG_SHUTDOWN_MS=15000      # düzgün kapanış için beklenen süre

# Mağaza / ekonomi
# SKORLIG_STORE_MODE=mock        # mock | disabled
# SKORLIG_EARLY_LIMIT=1000       # erken kuş bonusu alacak üye sayısı
# SKORLIG_EARLY_BONUS=200
